-AC_ARG_WITH(colm,
-	[AC_HELP_STRING([--with-colm], [location of colm install])],
-	[
-		COLM="$withval/bin/colm"
-		COLM_WRAP="$withval/bin/colm-wrap"
-		CPPFLAGS="-I$withval/include ${CPPFLAGS}"
-		CPPFLAGS="-I$withval/include/aapl ${CPPFLAGS}"
-		LDFLAGS="-L$withval/lib ${LDFLAGS}"
-		LIBCOLM_LA="$withval/lib/libcolm.la"
-		LIBFSM_LA="$withval/lib/libfsm.la"
-		COLM_SHARE="$withval/share"
-	],
-	[]
+dnl ----- Colm & FSM discovery (no pkg-config required) -----------------------
+
+dnl Native tools location (build machine)
+AC_ARG_WITH([colm-tools],
+  [AS_HELP_STRING([--with-colm-tools=PREFIX],[location of native colm tools])],
+  [
+    COLM="$withval/bin/colm"
+    COLM_WRAP="$withval/bin/colm-wrap"
+  ], [
+    AC_PATH_PROG([COLM], [colm])
+    AC_PATH_PROG([COLM_WRAP], [colm-wrap])
+  ]
 )
 
-AC_CHECK_FILES(
-	[$COLM],
-	[],
-	[AC_ERROR([colm is required to build ragel])]
+AC_SUBST([COLM])
+AC_SUBST([COLM_WRAP])
+
+dnl Target headers/libs location (install of colm which also ships libfsm+aapl)
+AC_ARG_WITH([colm],
+  [AS_HELP_STRING([--with-colm=PREFIX],
+                  [target prefix that provides libcolm, libfsm and aapl headers])],
+  [
+    COLM_INC="$withval/include"
+    AAPL_INC="$withval/include/aapl"
+    COLM_LIBDIR="$withval/lib"
+  ], [
+    COLM_INC='${includedir}'
+    AAPL_INC='${includedir}/aapl'
+    COLM_LIBDIR='${libdir}'
+  ]
 )
-AC_SUBST(COLM)
-AC_SUBST(COLM_WRAP)
-AC_SUBST(COLM_SHARE)
-AC_SUBST(LIBCOLM_LA)
-AC_SUBST(LIBFSM_LA)
 
+dnl Compose the flags. Prefer not to add -L when cross compiling (sysrooted),
+dnl but keep it harmless if PREFIX is explicitly provided.
+FSM_CFLAGS="-I${COLM_INC} -I${AAPL_INC}"
+COLM_CFLAGS=""
+FSM_LIBS="-L${COLM_LIBDIR} -lfsm"
+COLM_LIBS="-L${COLM_LIBDIR} -lcolm"
+
+AC_SUBST([FSM_CFLAGS])
+AC_SUBST([COLM_CFLAGS])
+AC_SUBST([FSM_LIBS])
+AC_SUBST([COLM_LIBS])
+
+dnl Light sanity checks on native (file tests are not allowed when cross compiling)
+AS_IF([test "x$cross_compiling" != "xyes"], [
+  AC_CHECK_PROG([HAVE_COLM_TOOL], [colm], [yes], [no])
+  AS_IF([test "x$HAVE_COLM_TOOL" = "xno" -a -z "$COLM"], [
+    AC_MSG_ERROR([colm tool not found; use --with-colm-tools=PREFIX])
+  ])
+])
+
+dnl Try to compile a trivial C++ snippet that includes fsm headers.
+dnl This exercises the include paths; the link step is left to the build.
+AC_LANG_PUSH([C++])
+save_CPPFLAGS="$CPPFLAGS"
+CPPFLAGS="$CPPFLAGS $FSM_CFLAGS $COLM_CFLAGS"
+AC_CHECK_HEADERS([libfsm/ragel.h aapl/dlist.h], [],
+  [AC_MSG_ERROR([missing libfsm/aapl headers; use --with-colm=PREFIX])])
+AC_LANG_POP([C++])
+
+#--
 EXPECTED_COLM_VER=0.14.7
 INSTALLED_COLM_VER=`$COLM -v | sed -n -e '1 {' -e 's/^.*version //' -e 's/ .*$//' -e p -e '}'`
 if test "x$INSTALLED_COLM_VER" != "x$EXPECTED_COLM_VER"; then
-	AC_ERROR( [check colm: expected version $EXPECTED_COLM_VER, but $INSTALLED_COLM_VER is installed] )
+  AC_ERROR([check colm: expected version $EXPECTED_COLM_VER, but $INSTALLED_COLM_VER is installed])
 fi
 
