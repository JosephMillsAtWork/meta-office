+
+
+# use '=' (not '+=')
+AM_CPPFLAGS = \
+  -I$(top_srcdir)/src/include \
+  -DBINDIR=\"$(bindir)\" \
+  $(FSM_CFLAGS) \
+  $(COLM_CFLAGS)
+
+libragel_la_LIBADD = $(FSM_LIBS) $(COLM_LIBS)
+ragel_LDADD        = libragel.la $(FSM_LIBS) $(COLM_LIBS)
